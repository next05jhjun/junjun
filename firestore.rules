rules_version = '2';
// サロンストック：みんなの品名データベースのルール
// ・products/{バーコード}/names/{ユーザーID} に、各ユーザーが登録した品名と種類を保存する
// ・ログイン（匿名）したユーザーだけが読める
// ・書き込みは自分の登録だけ。バーコードの形・項目・文字数をチェックする
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{jan}/names/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && jan.matches('^([0-9]{8}|[0-9]{12,14})$')
        && request.resource.data.keys().hasOnly(['name', 'cat', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.cat is string
        && request.resource.data.cat.size() <= 20
        && request.resource.data.at is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // それ以外はすべて禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
